# ==========================================================================
# Configuracion del backend (copiar este archivo a .env y completar).
# NO subir el archivo .env con credenciales reales al repositorio.
# ==========================================================================

# Entorno de la aplicacion: local | docker | production
APP_ENV=local

# Conexion a PostgreSQL (Supabase).
# En Supabase: Project Settings > Database > Connection string > "Session pooler".
# Formato (el driver es psycopg v3):
#   postgresql+psycopg://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Notas:
#  - Usar el "Session pooler" (IPv4, puerto 5432). El host directo db.<ref>.supabase.co
#    resuelve a IPv6 y suele fallar en redes sin IPv6.
#  - Reemplazar <PASSWORD> por la contrasena de la base. La URL codifica caracteres
#    especiales del password (ej. @ -> %40).
DATABASE_URL=

# Origenes permitidos por CORS, separados por coma.
# Ejemplo local: http://localhost:5173,http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Supabase Auth (Project Settings > API del proyecto de Fletes).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional: solo si el backend opera como service_role. NUNCA exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Enriquecimiento geográfico opcional.
GOOGLE_MAPS_API_KEY=
GEO_ENRICHMENT_ENABLED=true
GEO_FALLBACK_ENABLED=true
# Activar sólo si se acepta el uso de estos servicios y sus límites.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
ROUTING_URL=https://router.project-osrm.org
GEO_USER_AGENT=fletes-express/1.0
GEO_TIMEOUT_SECONDS=6
