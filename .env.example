# Frontend (Vite)
# URL base del backend. En desarrollo Vite hace proxy; en Docker nginx lo hace.
VITE_API_URL=/api

# Target opcional para proxy en desarrollo (Vite server.proxy)
VITE_PROXY_TARGET=http://localhost:8000

# Supabase Auth (Project Settings > API). Solo URL y anon key: son publicas.
# La service_role_key nunca va al frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
